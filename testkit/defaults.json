{
  "project": {
    "name": "Projeto",
    "stacks": "auto"
  },
  "reportsDir": "testkit-reports",
  "node": {
    "enabled": "auto",
    "workingDirectory": ".",
    "packageManager": "auto",
    "commands": {
      "install": "auto",
      "lint": "auto",
      "format": "auto",
      "typecheck": "auto",
      "test": "auto",
      "build": "auto"
    }
  },
  "python": {
    "enabled": "auto",
    "workingDirectory": ".",
    "sourcePaths": [
      "."
    ],
    "excludePaths": [
      ".venv",
      "venv",
      "node_modules",
      "build",
      "dist",
      "migrations",
      "testkit",
      ".tox"
    ],
    "coverageMin": 80,
    "commands": {
      "install": "auto",
      "lint": "ruff check {src}",
      "format": "ruff format --check {src}",
      "typecheck": "mypy {src}",
      "test": "python -m pytest --ignore=testkit --junitxml={reports}/python-junit.xml --cov --cov-report=xml:{reports}/python-coverage.xml --cov-report=term --cov-fail-under={coverageMin}",
      "sast": "bandit -q -r {src} -x {exclude} -ll",
      "audit": "auto"
    }
  },
  "web": {
    "enabled": "auto",
    "baseUrl": "${TESTKIT_BASE_URL:-http://localhost:3000}",
    "setupCommand": "",
    "startCommand": "",
    "readyPath": "/",
    "startTimeoutSeconds": 180,
    "browsers": [
      "chromium",
      "firefox",
      "webkit"
    ],
    "retries": 1,
    "workers": 2,
    "navigationTimeoutMs": 30000,
    "publicPages": [
      "/"
    ],
    "ignoreConsoleErrors": [
      "favicon\\.ico",
      "Download the React DevTools"
    ],
    "ignoreRequestFailures": [
      "google-analytics",
      "googletagmanager",
      "hotjar",
      "sentry"
    ],
    "checks": {
      "smoke": true,
      "accessibility": true,
      "security": true,
      "responsive": true,
      "performance": true,
      "crawl": true
    },
    "accessibility": {
      "tags": [
        "wcag2a",
        "wcag2aa",
        "wcag21a",
        "wcag21aa",
        "wcag22aa",
        "best-practice"
      ],
      "failOnImpacts": [
        "critical",
        "serious"
      ],
      "disableRules": [],
      "exclude": []
    },
    "security": {
      "requiredHeaders": [
        "x-content-type-options",
        "referrer-policy",
        "content-security-policy"
      ],
      "requireFrameProtection": true,
      "requireHstsOnHttps": true,
      "forbiddenHeaders": [
        "x-powered-by"
      ],
      "sensitivePaths": [
        "/.env",
        "/.env.local",
        "/.git/config",
        "/.git/HEAD",
        "/.DS_Store",
        "/config.json",
        "/.npmrc",
        "/docker-compose.yml",
        "/server.js.map"
      ],
      "checkCors": true,
      "checkMixedContent": true
    },
    "responsive": {
      "viewports": [
        {
          "name": "celular",
          "width": 375,
          "height": 812
        },
        {
          "name": "tablet",
          "width": 768,
          "height": 1024
        },
        {
          "name": "desktop",
          "width": 1440,
          "height": 900
        }
      ],
      "minTapTargetPx": 24
    },
    "performance": {
      "budgets": {
        "ttfbMs": 800,
        "domContentLoadedMs": 3000,
        "loadMs": 6000,
        "lcpMs": 2500,
        "cls": 0.1,
        "totalTransferKb": 3000,
        "jsTransferKb": 1000
      },
      "lighthouse": {
        "enabled": true,
        "runs": 3,
        "minScores": {
          "performance": 0.8,
          "accessibility": 0.9,
          "best-practices": 0.9,
          "seo": 0.8
        }
      }
    },
    "crawl": {
      "maxPages": 60,
      "checkExternalLinks": false,
      "excludePatterns": [
        "logout",
        "sign-out",
        "signout",
        "sair",
        "delete",
        "excluir",
        "mailto:",
        "tel:",
        "javascript:"
      ]
    }
  },
  "api": {
    "enabled": "auto",
    "openapi": "",
    "baseUrl": "",
    "maxExamples": 50,
    "excludeMethods": [
      "DELETE"
    ],
    "includePathRegex": "",
    "excludePathRegex": "",
    "extraArgs": ""
  },
  "security": {
    "secrets": true,
    "sast": true,
    "dependencies": true,
    "auditLevel": "high",
    "semgrepConfig": "p/default",
    "allowlistFile": ""
  },
  "links": {
    "enabled": true,
    "globs": [
      "**/*.md"
    ],
    "exclude": [
      "node_modules",
      ".venv",
      "venv",
      "testkit",
      "testkit-reports",
      "CHANGELOG.md"
    ],
    "checkExternal": true
  }
}
