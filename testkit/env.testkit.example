# Copie para .env.testkit na raiz (ignorado pelo Git).
# No CI, o segredo opcional TESTKIT_ENV recebe o mesmo conteúdo.

# URL do app de teste já iniciado (sobrescreve web.baseUrl).
# TESTKIT_BASE_URL=http://localhost:3000

# Cabeçalho livre para o teste de contrato da API.
# TESTKIT_API_AUTH_HEADER=X-Api-Key: chave-de-teste

# Chromium instalado no sistema, quando necessário.
# TESTKIT_CHROMIUM_PATH=/usr/bin/chromium
