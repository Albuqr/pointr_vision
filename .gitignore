# Environments and tooling
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
.jupyter_runtime/
.idea/
services/app/ui/node_modules/
services/app/ui/tsconfig.tsbuildinfo

# Real camera configs (phone addresses); docs/cameras.example.json is the committed example
cams*.json

# Session data, recordings and the local DB: never committed (CLAUDE.md rule 9)
sessions/
*.mp4
*.mov
*.avi
*.mkv
pointr.db*

# Downloaded test images of real people: fetched by the slow tests, never committed (rule 9)
tests/fixtures/downloads/

# Local copy of the docs bundle
pointr-docs.zip
.env
.env.testkit
testkit-reports/
.claude/skills/
.suite/media/auth/
.suite/media/recordings/
testkit/web/node_modules/
testkit/.bin/

# request-logger: its own npm project. Captured logs hold full prompts and code; never committed
request-logger/node_modules/
request-logger/logs/*
!request-logger/logs/.gitkeep
request-logger/.agent-choice.json
