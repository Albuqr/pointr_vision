#!/usr/bin/env bash
# Pre-commit gate (enable once per clone: git config core.hooksPath .githooks).
# A medium run while the architecture changes; CI runs the full suite on every push.
set -euo pipefail

# 1. Never commit secrets files.
if git diff --cached --name-only | grep -E '(^|/)\.env(\.testkit)?$' >/dev/null; then
  echo "pre-commit: refusing to commit .env / .env.testkit" >&2
  exit 1
fi

# 2. Lint, then the default tests minus R1's recording and replay files (about 2 of the
#    suite's 5.5 minutes on the dev notebook, measured 2026-10-28). Run those three yourself when touching recording
#    or replay.
py=python
[[ -x .venv/Scripts/python ]] && py=.venv/Scripts/python
[[ -x .venv/bin/python ]] && py=.venv/bin/python
"$py" -m ruff check services tests
"$py" -m pytest -q -p no:cacheprovider \
  --ignore=tests/edge/test_recorder.py \
  --ignore=tests/edge/test_replay.py \
  --ignore=tests/edge/test_record_live.py
