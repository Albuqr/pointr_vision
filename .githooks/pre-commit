#!/usr/bin/env bash
# Pre-commit gate (enable once per clone: git config core.hooksPath .githooks).
# Cheap checks only; tests are targeted while working and the full suite runs on request (D-062).
set -euo pipefail

# 1. Never commit secrets files.
if git diff --cached --name-only | grep -E '(^|/)\.env(\.testkit)?$' >/dev/null; then
  echo "pre-commit: refusing to commit .env / .env.testkit" >&2
  exit 1
fi

# 2. Lint the staged Python files; nothing else to check when none are staged.
mapfile -t staged_py < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
[[ ${#staged_py[@]} -eq 0 ]] && exit 0
py=python
[[ -x .venv/Scripts/python ]] && py=.venv/Scripts/python
[[ -x .venv/bin/python ]] && py=.venv/bin/python
"$py" -m ruff check "${staged_py[@]}"
